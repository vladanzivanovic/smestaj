# Symfony app secret — generate with: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=ChangeMeToARandom32ByteHex

# Database (local dev uses the Docker Compose 'mysql' service)
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=smestaj
DATABASE_USER=root
DATABASE_PASSWORD=changeme

# Mailer — local dev points at the Mailcatcher service; prod operator must override
MAILER_DSN=smtp://mailcatcher:1025

# Public URL / scheme
BASE_URL=localhost:9505
HOST_SCHEMA=http
DEFAULT_LOCALE=rs

# Site-wide email addresses
EMAIL_ADDRESS=noreply@example.local
CONTACT_RECIPIENT_EMAIL=contact@example.local

# Assetic base path (usually empty)
ASSETIC_BASE_PATH=

# Facebook integration
FB_ID=
FB_SECRET=
FB_PAGE_ID=
FB_GRAPH_VERSION=v2.9
FB_PAGE_TOKEN=

# Third-party service keys
ADSENSE_KEY=
RE_CAPTCHA_KEY=
GOOGLE_API_KEY=
GOOGLE_ANALYTICS=
GOOGLE_MAPS_KEY=
SENTRY_JAVASCRIPT_DNS=
YOUTUBE_API_KEY=
