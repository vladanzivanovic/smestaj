{
    "name": "vladapoz/smestaj",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "SiteBundle\\": "src/SiteBundle",
            "AdminBundle\\": "src/AdminBundle"
        },
        "classmap": [
            "app/AppKernel.php",
            "app/AppCache.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "beberlei/doctrineextensions": "^1.3",
        "behat/transliterator": "^1.5",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/migrations": "^3.7",
        "doctrine/orm": "^3.0",
        "exercise/htmlpurifier-bundle": "^5.2",
        "friendsofsymfony/jsrouting-bundle": "^3.2",
        "gedmo/doctrine-extensions": "^3.15",
        "jms/serializer-bundle": "^5.4",
        "liip/imagine-bundle": "^2.12",
        "mobiledetect/mobiledetectlib": "^4.8",
        "monolog/monolog": "^3.0",
        "nelmio/security-bundle": "^3.1",
        "presta/sitemap-bundle": "^4.0",
        "symfony/asset": "^8.1",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/doctrine-bridge": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/error-handler": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/mime": "^8.1",
        "symfony/monolog-bundle": "^4.0",
        "symfony/password-hasher": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/security-core": "^8.1",
        "symfony/security-csrf": "^8.1",
        "symfony/security-http": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/twig-bridge": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/var-exporter": "^8.1",
        "symfony/web-link": "^8.1",
        "symfony/webpack-encore-bundle": "^2.0",
        "symfony/yaml": "^8.1",
        "twig/extra-bundle": "^3.8",
        "twig/intl-extra": "^3.8",
        "twig/twig": "^3.8",
        "webmozart/assert": "^1.11",
        "willdurand/js-translation-bundle": "^8.0"
    },
    "require-dev": {
        "symfony/debug-bundle": "^8.1",
        "symfony/maker-bundle": "^1.48",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/web-profiler-bundle": "^8.1"
    },
    "scripts": {
        "develop": [
            "composer dump-autoload --classmap-authoritative --ansi",
            "composer install",
            "composer dump-autoload --classmap-authoritative --ansi",
            "php bin/console doctrine:cache:clear-metadata",
            "php bin/console doctrine:migrations:migrate --no-interaction --ansi",
            "php bin/console assets:install --symlink --relative web/js",
            "php bin/console fos:js-routing:dump --format=json --target=web/js/fos_js_routes.json",
            "php bin/console bazinga:js-translation:dump web/js --format json --merge-domains",
            "npm install",
            "npm run dev"
        ],
        "deploy": [
            "sudo -u www-data composer dump-autoload --optimize --no-dev --classmap-authoritative",
            "sudo -u www-data composer install --no-dev --optimize-autoloader",
            "sudo -u www-data composer dump-autoload --optimize --no-dev --classmap-authoritative",
            "sudo -u www-data php bin/console doctrine:cache:clear-metadata -e prod",
            "sudo -u www-data php bin/console doctrine:migrations:migrate --no-interaction --ansi -e prod",
            "sudo -u www-data php bin/console cache:clear --no-warmup --ansi -e prod",
            "sudo -u www-data php bin/console cache:warmup -e prod",
            "sudo -u www-data php bin/console assets:install --symlink --relative web/js -e prod",
            "sudo -u www-data php bin/console fos:js-routing:dump --format=json --target=web/js/fos_js_routes.json -e prod",
            "npm install",
            "npm run build",
            "sudo -u www-data php bin/console presta:sitemaps:dump web --gzip -e prod",
            "sudo -u www-data php bin/console liip:imagine:cache:remove -e prod",
            "sudo -u www-data php bin/console fos:js-routing:dump --format=json --target=web/js/fos_js_routes.json -e prod",
            "sudo -u www-data php bin/console bazinga:js-translation:dump web/js --format=json --merge-domains -e prod"
        ],
        "cache:clear": [
            "php bin/console cache:clear --no-warmup --ansi",
            "php bin/console cache:warmup"
        ],
        "route-locale-generate": [
            "php bin/console fos:js-routing:dump --format=json --target=web/js/fos_js_routes.json",
            "php bin/console bazinga:js-translation:dump web/js --format=json --merge-domains"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "symfony-app-dir": "app",
        "symfony-bin-dir": "bin",
        "symfony-var-dir": "var",
        "symfony-web-dir": "web",
        "symfony-tests-dir": "tests",
        "symfony-assets-install": "relative",
        "branch-alias": null,
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
